---
export interface Props {
  title: string
  copy: string
  theme: 'teal' | 'purple' | 'yellow'
}

const { title, copy, theme = 'teal' } = Astro.props as Props
const iconClasses = {
  teal: 'bg-teal-50 text-teal-700 dark:bg-teal-700 dark:text-teal-50',
  purple: 'bg-purple-50 text-purple-700 dark:bg-purple-700 dark:text-purple-50',
  yellow: 'bg-yellow-50 text-yellow-700 dark:bg-yellow-700 dark:text-yellow-50',
}
---

<li class="flex flex-col gap-8 group relative border border-theme rounded-lg p-6">
  {
    Astro.slots.icon && (
      <span class:list={['w-12 h-12 rounded-lg p-3', iconClasses[theme]]}>
        <slot name="icon" class="size-6" />
      </span>
    )
  }
  <div class="flex flex-col gap-2">
    <h3 class="text-lg font-semibold text-primary">{title}</h3>
    <p class="text-base">{copy}</p>
  </div>
</li>
