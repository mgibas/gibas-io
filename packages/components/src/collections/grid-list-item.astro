---
import type { Theme } from '@/types'

export interface Props {
  title: string
  copy?: string
  theme: Theme
}

const { title, copy, theme = 'teal' } = Astro.props as Props
const iconClasses = {
  teal: 'bg-teal-50 text-teal-700 ring-teal-600 dark:bg-teal-400/10 dark:text-teal-400 dark:ring-teal-400/20',
  purple:
    'bg-purple-50 text-purple-700 ring-purple-600 dark:bg-purple-400/10 dark:text-purple-400 dark:ring-purple-400/20',
  yellow:
    'bg-yellow-50 text-yellow-700 ring-yellow-600 dark:bg-yellow-400/10 dark:text-yellow-400 dark:ring-yellow-400/20',
}
---

<li class="flex flex-col gap-8 group relative border border-theme rounded-lg p-6">
  {
    Astro.slots.icon && (
      <span class:list={['w-12 h-12 rounded-lg p-3 ring-1 ring-inset', iconClasses[theme]]}>
        <slot name="icon" class="size-6" />
      </span>
    )
  }
  <div class="flex flex-col gap-2">
    <h3 class="text-lg font-semibold text-primary"><slot name="title">{title}</slot></h3>
    <p class="text-base"><slot>{copy}</slot></p>
  </div>
</li>
