---
export interface TextareaProps {
  class?: string
  id?: string
  name?: string
  autocomplete?: string
  required?: boolean
  rows?: number
}
const { class: classes, id, name, autocomplete, required = false, rows = 4 } = Astro.props
---

<textarea
  class:list={[
    'text-base text-primary rounded-md border border-zinc-400 px-3.5 py-2 leading-5 dark:bg-zinc-800',
    classes,
  ]}
  id={id}
  rows={rows}
  name={name}
  required={required}></textarea>
