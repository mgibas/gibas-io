---
export interface LinkProps {
  class?: string
  href?: string
  bare?: boolean
}
const { class: classes, href = '', bare = false } = Astro.props
const external = href.startsWith('http')
const externalClasses = external && !bare ? "after:content-['↗']" : ''
---

<a href={href} target={external ? '_blank' : undefined} class:list={[externalClasses, classes]}>
  <slot />
</a>
