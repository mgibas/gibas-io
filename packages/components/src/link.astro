---
export interface LinkProps {
  class?: string
  href?: string
  bare?: boolean
}
const { class: classes, href = '', bare = false } = Astro.props
const external = href.startsWith('http')
const showExternalIcon = external && !bare
---

<a href={href} target={external ? '_blank' : undefined} class:list={[classes]}><slot />{
    showExternalIcon && (
      <svg
        class="ml-0.5 inline-block size-[0.8em] align-[-0.05em]"
        aria-hidden="true"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2.25"
        stroke-linecap="round"
        stroke-linejoin="round">
        <path d="M7 17 17 7M8 7h9v9" />
      </svg>
    )
  }{external && <span class="sr-only"> (opens in a new tab)</span>}</a>
