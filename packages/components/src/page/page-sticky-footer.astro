---
import type { BaseProps } from '@/types'

const { class: classes } = Astro.props as BaseProps
---

<div class:list={['sticky bottom-0 flex flex-col gap-4 bg-theme border-t border-theme', classes]}>
  {
    Astro.slots.default && (
      <div>
        <slot />
      </div>
    )
  }

  <div class="flex gap-4">
    <slot name="actions" />
  </div>
</div>
