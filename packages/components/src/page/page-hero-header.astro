---
export interface Props {
  class?: string
  teaser: string
  title: string
  subtitle: string
}
const { class: className, teaser, title, subtitle } = Astro.props
---

<div class={`py-24 sm:py-32 ${className}`}>
  <div class="max-w-2xl lg:mx-0">
    <p
      class="text-base/7 font-semibold bg-gradient-to-r from-sunset-orange via-sunset-violet to-sunset-violet bg-clip-text text-transparent">
      {teaser}
    </p>
    <h1 class="mt-2 text-5xl font-semibold tracking-tight text-primary sm:text-7xl">{title}</h1>
    <p class="mt-8 text-pretty text-lg font-medium text-secondary sm:text-xl/8">{subtitle}</p>
  </div>
</div>
