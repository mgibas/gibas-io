---
import type { BaseProps } from '@/types'
import ChevronLeft from '@gibas/components/icons/chevron-left'

interface PageHeaderProps extends BaseProps {
  title: string
  subtitle?: string
  'back-href': string
  'back-copy': string
  'hide-actions-breakpoint'?: string
}

const {
  title,
  subtitle,
  class: classes,
  ['hide-actions-breakpoint']: hideActionsBreakpoint,
  'back-copy': backCopy,
  'back-href': backHref,
} = Astro.props as PageHeaderProps
const actionsWrapperClass = {
  default: 'flex',
  sm: 'hidden sm:flex',
  md: 'hidden md:flex',
  lg: 'hidden lg:flex',
  xl: 'hidden xl:flex',
}[hideActionsBreakpoint ?? 'default']
---

<div class:list={[classes]}>
  <div>
    <nav aria-label="Back to Custom Element Recipes">
      <a href={backHref} class="flex gap-2 items-center text-sm font-medium text-secondary">
        <ChevronLeft class="size-4" />
        {backCopy}
      </a>
    </nav>
  </div>
  <div class="mt-2 gap-4 flex items-center justify-between">
    <div class="min-w-0 flex-1">
      <h1 class="text-2xl/7 font-bold text-primary sm:truncate sm:text-3xl sm:tracking-tight">{title}</h1>
      {subtitle && <span class="text-secondary">{subtitle}</span>}
    </div>
    <div class={`shrink-0 md:ml-4 md:mt-0 gap-2 ${actionsWrapperClass}`}>
      <slot name="actions" />
    </div>
  </div>
</div>
