---
import Layout from '../layouts/Layout.astro'
import Typewriter from '../components/typewriter.astro'
---

<Layout title="Maciej Gibas">
  <div slot="header" class="grid min-h-screen place-content-center">
    <div class="relative pb-[72px] sm:pb-12">
      <span class="text-gray-600 dark:text-gray-300 font-semibold">Hello, I'm</span>
      <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl md:text-6xl">Maciej Gibas</h1>
      <Typewriter
        class="absolute bottom-0 left-0"
        prefix="Frontend"
        copy={['leader', 'architect', 'developer', 'designer']}
      />
    </div>
  </div>
</Layout>
