---
import Layout from '@layouts/SlidesDeck.astro'
import Slide from '@components/slide-deck/slide.astro'
import Link from '@components/slide-deck/link.astro'
import FlatList from '@components/slide-deck/flat-list.astro'
import FlatListItem from '@components/slide-deck/flat-list-item.astro'
import Codepen from '@components/codepen.astro'

import oneUnderAnother from './one-under-another.png'
import sideBySide from './side-by-side.png'
import columns from './columns.png'
import singleAxis from './single-axis.png'
import twoAxis from './two-axis.png'
import wrap1 from './wrap-1.png'
import wrap2 from './wrap-2.png'
import gridWrap1 from './grid-wrap-1.png'
import gridWrap2 from './grid-wrap-2.png'
import gridWrap3 from './grid-wrap-3.png'
import subGrids from './subgrids.png'
import masonry from './masonry.png'
---

<Layout>
  <Slide level="1" title="CSS Layouts" titleSecondary="Frontend Awesome!" titleTertiary="10/20/2022" />

  <Slide level="2" title="About Me">
    <p>Maciej Gibas</p>
    <p>
      Frontend Lead Engineer @ <Link href="https://infotechinc.com">Infotech</Link>
    </p>
    <p>☕ 🍞 ⌨️ 🏎 🏋🏼 🏃🏼 🎧 🎬</p>
    <Link href="https://gibas.io">gibas.io</Link> • <Link href="https://twitter.com/gibasmaciej">@gibasmaciej</Link>
  </Slide>

  <section>
    <Slide level="2" title="Back in the_day" alt />

    <Slide level="3" title="Tables" titleSecondary="Simple and effective">
      <Codepen class="w-full" id="jOxvBrK" />
      <FlatList slot="contentSecondary">
        <FlatListItem>First standard layout technique</FlatListItem>
        <FlatListItem>Netscape 1993</FlatListItem>
        <FlatListItem>HTML 3.2 1997</FlatListItem>
      </FlatList>
    </Slide>

    <Slide level="3" title="Floats" titleSecondary="Nooooo!!! 😱">
      <Codepen class="w-full" id="ExLeoMP" />
      <FlatList slot="contentSecondary">
        <FlatListItem>First css layout technique</FlatListItem>
        <FlatListItem>Netscape ~1998</FlatListItem>
      </FlatList>
    </Slide>

    <Slide level="3" title="Grid_System" titleSecondary="Responsiveness" alt>
      <Codepen class="w-full" id="abGaYVR" />
      <FlatList slot="contentSecondary">
        <FlatListItem>RESPONSIVE</FlatListItem>
        <FlatListItem>iPhone 2007</FlatListItem>
        <FlatListItem>bootstrap 1.0 2011</FlatListItem>
      </FlatList>
    </Slide>
  </section>

  <section>
    <Slide level="2" title="Current o_ptions" />

    <Slide level="3" title="Block & Inline" titleSecondary="Back to basics">
      <Codepen class="w-full" id="KKRGozz" />
      <FlatList slot="contentSecondary">
        <FlatListItem>No wrapper</FlatListItem>
        <FlatListItem>maybe no css</FlatListItem>
        <FlatListItem>mix and match</FlatListItem>
      </FlatList>
    </Slide>

    <Slide level="3" title="Columns" titleSecondary="Newspaper columns">
      <Codepen class="w-full" id="gOzdJLj" />
      <FlatList slot="contentSecondary">
        <FlatListItem>Dominantly "articles"</FlatListItem>
        <FlatListItem>break inside</FlatListItem>
        <FlatListItem>no horizontal gap</FlatListItem>
      </FlatList>
    </Slide>

    <Slide level="3" title="Flexbox" titleSecondary="Content content content!">
      <Codepen class="w-full" id="poVxLxw" />
      <FlatList slot="contentSecondary">
        <FlatListItem>Content focused</FlatListItem>
        <FlatListItem>single axis</FlatListItem>
        <FlatListItem>feature rich</FlatListItem>
        <FlatListItem>gap</FlatListItem>
        <FlatListItem>responsivenes</FlatListItem>
        <FlatListItem>reverse...a11y</FlatListItem>
      </FlatList>
    </Slide>

    <Slide level="3" title="CSS Grid" titleSecondary="Second axis of flexbox">
      <Codepen class="w-full" id="dyegqLp" />
      <FlatList slot="contentSecondary">
        <FlatListItem>Layout focused</FlatListItem>
        <FlatListItem>two axes</FlatListItem>
        <FlatListItem>feature rich</FlatListItem>
      </FlatList>
    </Slide>
  </section>
</Layout>
