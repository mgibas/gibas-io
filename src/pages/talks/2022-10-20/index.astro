---
import Layout from '@layouts/SlidesDeck.astro'
import Slide from '@components/slide-deck/slide.astro'
import Link from '@components/slide-deck/link.astro'
import List from '@components/slide-deck/list.astro'
import ListItem from '@components/slide-deck/list-item.astro'
import Image from '@components/slide-deck/image.astro'
import FlatList from '@components/slide-deck/flat-list.astro'
import FlatListItem from '@components/slide-deck/flat-list-item.astro'
import Codepen from '@components/codepen.astro'

import SlideAbout from '@components/slides/slide-about.astro'
import SlideBye from '@components/slides/slide-bye.astro'

import oneUnderAnother from './one-under-another.png'
import sideBySide from './side-by-side.png'
import columns from './columns.png'
import singleAxis from './single-axis.png'
import twoAxis from './two-axis.png'
import wrap1 from './wrap-1.png'
import wrap2 from './wrap-2.png'
import gridWrap1 from './grid-wrap-1.png'
import gridWrap2 from './grid-wrap-2.png'
import gridWrap3 from './grid-wrap-3.png'
import subGrids from './subgrids.png'
import masonry from './masonry.png'
import ContentFrame from '@components/slide-deck/content-frame.astro'
---

<Layout>
  <Slide level="1" title="CSS Layouts" title-secondary="Frontend Awesome!" title-tertiary="10/20/2022" />

  <SlideAbout />

  <section>
    <Slide level="2" title="Back in the_day" alt />

    <Slide level="3" title="Tables" title-secondary="Simple and effective">
      <ContentFrame><Codepen id="jOxvBrK" /></ContentFrame>

      <FlatList slot="contentSecondary">
        <FlatListItem>First standard layout technique</FlatListItem>
        <FlatListItem>Netscape 1993</FlatListItem>
        <FlatListItem>HTML 3.2 1997</FlatListItem>
      </FlatList>
    </Slide>

    <Slide level="3" title="Floats" title-secondary="Nooooo!!! 😱">
      <ContentFrame><Codepen id="ExLeoMP" /></ContentFrame>
      <FlatList slot="contentSecondary">
        <FlatListItem>First css layout technique</FlatListItem>
        <FlatListItem>Netscape ~1998</FlatListItem>
      </FlatList>
    </Slide>

    <Slide level="3" title="Grid_System" title-secondary="Responsiveness" alt>
      <ContentFrame><Codepen id="abGaYVR" /></ContentFrame>
      <FlatList slot="contentSecondary">
        <FlatListItem>RESPONSIVE</FlatListItem>
        <FlatListItem>iPhone 2007</FlatListItem>
        <FlatListItem>bootstrap 1.0 2011</FlatListItem>
      </FlatList>
    </Slide>
  </section>

  <section>
    <Slide level="2" title="Current o_ptions" />

    <Slide level="3" title="Block & Inline" title-secondary="Back to basics">
      <ContentFrame><Codepen id="KKRGozz" /></ContentFrame>
      <FlatList slot="contentSecondary">
        <FlatListItem>No wrapper</FlatListItem>
        <FlatListItem>maybe no css</FlatListItem>
        <FlatListItem>mix and match</FlatListItem>
      </FlatList>
    </Slide>

    <Slide level="3" title="Columns" title-secondary="Newspaper columns">
      <ContentFrame><Codepen id="gOzdJLj" /></ContentFrame>
      <FlatList slot="contentSecondary">
        <FlatListItem>Dominantly "articles"</FlatListItem>
        <FlatListItem>break inside</FlatListItem>
        <FlatListItem>no horizontal gap</FlatListItem>
      </FlatList>
    </Slide>

    <Slide level="3" title="Flexbox" title-secondary="Content content content!">
      <ContentFrame><Codepen id="poVxLxw" /></ContentFrame>
      <FlatList slot="contentSecondary">
        <FlatListItem>Content focused</FlatListItem>
        <FlatListItem>single axis</FlatListItem>
        <FlatListItem>feature rich</FlatListItem>
        <FlatListItem>gap</FlatListItem>
        <FlatListItem>responsivenes</FlatListItem>
        <FlatListItem>reverse...a11y</FlatListItem>
      </FlatList>
    </Slide>

    <Slide level="3" title="CSS Grid" title-secondary="Second axis of flexbox">
      <ContentFrame><Codepen id="dyegqLp" /></ContentFrame>
      <FlatList slot="contentSecondary">
        <FlatListItem>Layout focused</FlatListItem>
        <FlatListItem>two axes</FlatListItem>
        <FlatListItem>feature rich</FlatListItem>
      </FlatList>
    </Slide>
  </section>

  <section>
    <Slide level="2" title="What When" />

    <Slide level="3" title="One under another">
      <ContentFrame center><Image src={oneUnderAnother} alt="One element under another example." /></ContentFrame>

      <FlatList slot="contentSecondary">
        <FlatListItem>Content base size</FlatListItem>
        <FlatListItem>✅ Block</FlatListItem>
      </FlatList>
    </Slide>

    <Slide level="3" title="Side by side">
      <ContentFrame><Image src={sideBySide} alt="One element next to another example." /></ContentFrame>

      <FlatList slot="contentSecondary">
        <FlatListItem>Content base size</FlatListItem>
        <FlatListItem>✅ Inline</FlatListItem>
      </FlatList>
    </Slide>

    <Slide level="3" title="Simple columns">
      <ContentFrame><Image src={columns} alt="Columns example." /></ContentFrame>

      <FlatList slot="contentSecondary">
        <FlatListItem>AKA newspaper columns</FlatListItem>
        <FlatListItem>✅ Columns</FlatListItem>
      </FlatList>
    </Slide>

    <Slide level="3" title="Single axis">
      <ContentFrame><Image src={singleAxis} alt="Single axis example." /></ContentFrame>

      <FlatList slot="contentSecondary">
        <FlatListItem>"Ratio" based size</FlatListItem>
        <FlatListItem>✅ Flexbox</FlatListItem>
      </FlatList>
    </Slide>

    <Slide level="3" title="Two axes">
      <ContentFrame><Image src={twoAxis} alt="Two axes example." /></ContentFrame>

      <FlatList slot="contentSecondary">
        <FlatListItem>Grid focused</FlatListItem>
        <FlatListItem>✅ Grid</FlatListItem>
      </FlatList>
    </Slide>

    <Slide level="3" title="Wrapping">
      <ContentFrame class="fragment">
        <Image src={wrap1} alt="Wrapping before example." />
      </ContentFrame>
      <ContentFrame class="fragment">
        <Image class="fragment" src={wrap2} alt="Wrapping after example." />
      </ContentFrame>
      <FlatList slot="contentSecondary">
        <FlatListItem>✅ Flexbox</FlatListItem>
      </FlatList>
    </Slide>

    <Slide level="3" title="'Grid' wrapping">
      <div class="r-stack">
        <Image class="fragment" src={gridWrap1} alt="Grid wrapping before example." />
        <Image class="fragment" src={gridWrap2} alt="Grid wrapping after example." />
        <Image class="fragment" src={gridWrap3} alt="Grid wrapping flex after example." />
      </div>
      <FlatList slot="contentSecondary">
        <FlatListItem>✅ Flexbox</FlatListItem>
      </FlatList>
    </Slide>
  </section>

  <section>
    <Slide level="2" title="What’s coming" />

    <Slide level="3" title="Sub grids">
      <ContentFrame><Codepen id="LYmMLKB" /></ContentFrame>
      <FlatList slot="contentSecondary">
        <FlatListItem />
      </FlatList>
    </Slide>

    <Slide level="3" title="Sub grids">
      <ContentFrame><Image class="!max-h-[25vh]" src={subGrids} alt="Subgrid example." /></ContentFrame>
      <FlatList slot="contentSecondary">
        <FlatListItem />
      </FlatList>
    </Slide>

    <Slide level="3" title="Masonry">
      <ContentFrame><Codepen id="gOzZxgb" /></ContentFrame>
      <FlatList slot="contentSecondary">
        <FlatListItem>Photo galery</FlatListItem>
        <FlatListItem>Pintrest layout</FlatListItem>
        <FlatListItem>Still draft :(</FlatListItem>
      </FlatList>
    </Slide>

    <Slide level="3" title="Masonry">
      <ContentFrame><Image src={masonry} alt="Masonry example." /></ContentFrame>
      <FlatList slot="contentSecondary">
        <FlatListItem />
      </FlatList>
    </Slide>

    <Slide level="3" title="Container queries">
      <ContentFrame><Codepen id="zYjyJOP" /></ContentFrame>
      <FlatList slot="contentSecondary">
        <FlatListItem />
      </FlatList>
    </Slide>
  </section>

  <Slide level="2" title="Resources">
    <List>
      <ListItem>
        <div>
          <Link href="http://grid-layout.com/history.html">Web layout history</Link>
        </div>
        <div class="text-lg text-secondary">Steven D. Anderson • grid-layout.com</div>
      </ListItem>
      <ListItem>
        <div>
          <Link href="https://css-tricks.com/in-defense-of-tables-and-floats-in-modern-day-development/">
            In Defense of Tables and Floats in Modern Day Development
          </Link>
        </div>
        <div class="text-lg text-secondary">John Macpherson • css-tricks.com</div>
      </ListItem>

      <ListItem>
        <div>
          <Link href="https://css-tricks.com/snippets/css/a-guide-to-flexbox/">A Complete Guide to Flexbox</Link>
        </div>
        <div class="text-lg text-tertiary">Chris Coyier • css-tricks.com</div>
      </ListItem>
      <ListItem>
        <div>
          <Link href="https://css-tricks.com/snippets/css/complete-guide-grid/">A Complete Guide to Grid</Link>
        </div>
        <div class="text-lg text-tertiary">Chris House • css-tricks.com</div>
      </ListItem>
      <ListItem>
        <div>
          <Link href="https://stackoverflow.com/a/55073039">Advantage Flexbox</Link>
        </div>
        <div class="text-lg text-tertiary">Michael Benjamin • stackoverflow.com</div>
      </ListItem>
      <ListItem>
        <div>
          <Link href="https://www.smashingmagazine.com/native-css-masonry-layout-css-grid/"
            >Native CSS Masonry Layout In CSS Grid
          </Link>
        </div>
        <div class="text-lg text-tertiary">Rachel Andrew • smashingmagazine.com</div>
      </ListItem>
      <ListItem>
        <div>
          <Link href="https://1linelayouts.glitch.me">1-Line Layouts</Link>
        </div>
        <div class="text-lg text-tertiary">Una • glitch.me</div>
      </ListItem>
    </List>
  </Slide>

  <SlideBye />
</Layout>
