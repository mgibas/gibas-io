---
import '/node_modules/reveal.js/dist/reveal.css'
import '@assets/styles-slides.css'
import Base from '@layouts/Base.astro'
export interface SlidesDeckProps {
  title: string
}
const { title } = Astro.props
---

<Base title={title} class="reveal overflow-hidden">
  <div class="slides">
    <slot />
  </div>
</Base>

<script>
  import Reveal from 'reveal.js'

  const urlSearchParams = new URLSearchParams(location.search)
  const { slideh = 0, slidev = 0 } = Object.fromEntries(
    Array.from(urlSearchParams.entries()).map(([key, value]) => [key, Number(value)])
  )
  const syncFragmentStatus = (slide: HTMLElement) => {
    const fragments = slide.querySelectorAll('.fragment').length
    const visibleFragments = slide.querySelectorAll('.fragment.visible').length
    slide.classList.toggle('all-visible', fragments === visibleFragments)
  }
  const deck = new Reveal({
    disableLayout: false,
    center: false,
    width: 1440,
    height: 900,
  })
  deck.initialize().then(() => {
    deck.slide(slideh, slidev)
  })
  deck.on('slidechanged', (e: any) => {
    syncFragmentStatus(e.currentSlide)
    urlSearchParams.set('slideh', e.indexh)
    urlSearchParams.set('slidev', e.indexv)

    const url = new URL(location.pathname, location.origin)
    url.search = urlSearchParams.toString()
    history.pushState({ path: url.toString() }, '', url.toString())
  })

  deck.on('fragmentshown', (e: any) => {
    syncFragmentStatus(e.fragment.closest('section'))
  })
  deck.on('fragmenthidden', (e: any) => {
    syncFragmentStatus(e.fragment.closest('section'))
  })
</script>
