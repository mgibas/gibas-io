---
export interface Props {
  title: string
}

const { title } = Astro.props
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
  </head>
  <body class="min-w-screen bg-white text-gray-800 dark:bg-gray-800 dark:text-white">
    <header>
      <slot name="header" />
    </header>

    <main class="prose prose-lg prose-slate prose-rose mx-auto px-4 py-16 dark:prose-invert">
      <slot />
    </main>

    <footer>
      <slot name="footer" />
    </footer>
  </body>
</html>
