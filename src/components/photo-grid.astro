---
const { class: classes, photos = [] } = Astro.props
---

<div class="flex gap-2 overflow-x-scroll md:block md:columns-4">
  {
    photos.map(({ src }) => (
      <img
        src={src}
        class="object-cover object-center w-full 
              mb-2
              max-h-80
              saturate-0
              hover:saturate-100
              transition-all
              duration-500
              ease-in-out
              md:max-h-60
              md:aspect-video
              md:[&:nth-child(4n)]:aspect-square
              md:[&:nth-child(4n)]:max-h-80
              md:[&:nth-child(4n+1)]:aspect-square
              md:[&:nth-child(4n+1)]:max-h-80
              "
      />
    ))
  }
</div>
