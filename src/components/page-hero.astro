---
const { class: classes } = Astro.props
---

<svg class:list={['overflow-visible', classes]} viewBox="0 0 681 821" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <clipPath id="clipping-m"><use xlink:href="#letter-m"></use></clipPath>
    <clipPath id="clipping-g"><use xlink:href="#letter-g"></use></clipPath>
    <linearGradient id="gradient-light" x1="0" x2="0" y1="0" y2="1" gradientTransform="rotate(35)">
      <stop offset="0%" stop-color="white" stop-opacity=".7"></stop>
      <stop offset="40%" stop-color="white" stop-opacity=".09"></stop>
      <stop offset="80%" stop-color="white" stop-opacity=".6"></stop>
      <stop offset="100%" stop-color="white"></stop>
    </linearGradient>
    <linearGradient id="gradient-dark" x1="0" x2="0" y1="0" y2="1" gradientTransform="rotate(35)">
      <stop offset="0%" stop-color="black" stop-opacity=".7"></stop>
      <stop offset="40%" stop-color="black" stop-opacity=".09"></stop>
      <stop offset="80%" stop-color="black" stop-opacity=".6"></stop>
      <stop offset="100%" stop-color="black"></stop>
    </linearGradient>
    <filter id="image-filter">
      <feColorMatrix in="SourceGraphic" type="saturate" values="0"></feColorMatrix>
    </filter>
  </defs>

  <path
    id="letter-m"
    d="M194.287 450.6L70.758 81.9025H68.237C68.6571 90.3059 69.2874 102.281 70.1277 117.827C70.9681 132.953 71.5983 149.55 72.0185 167.617C72.8588 185.264 73.279 201.861 73.279 217.407V450.6H0.799988V0.599976H112.985L231.472 354.171H233.993L357.523 0.599976H469.708V450.6H392.817V213.625C392.817 199.339 393.027 183.793 393.447 166.987C394.287 149.76 394.918 133.583 395.338 118.457C396.178 102.911 396.808 90.9361 397.229 82.5327H394.708L266.136 450.6H194.287Z">
  </path>
  <image
    x="-40"
    y="-100"
    width="510"
    clip-path="url(#clipping-m)"
    xlink:href="/hero-1.jpeg"
    filter="url(#image-filter)"
  />
  <rect
    width="500"
    height="500"
    clip-path="url(#clipping-m)"
    class="fill-[url(#gradient-dark)] dark:fill-[url(#gradient-light)]"></rect>

  <path
    id="letter-g"
    d="M514.972 574.142H680.503V796.69C657.206 804.456 633.296 810.382 608.773 814.469C584.25 818.556 556.457 820.6 525.394 820.6C481.253 820.6 443.855 811.812 413.201 794.238C382.547 776.663 359.25 751.118 343.31 717.603C327.37 684.088 319.4 643.216 319.4 594.987C319.4 549.21 328.392 509.565 346.375 476.05C364.359 442.535 390.108 416.581 423.623 398.189C457.547 379.796 498.828 370.6 547.465 370.6C571.171 370.6 594.059 373.052 616.13 377.957C638.61 382.453 659.046 388.788 677.438 396.962L650.463 461.336C636.566 454.387 620.422 448.665 602.029 444.169C584.046 439.265 565.245 436.812 545.626 436.812C515.79 436.812 490.04 443.352 468.378 456.431C446.716 469.51 429.959 488.107 418.106 512.221C406.662 535.927 400.939 563.924 400.939 596.213C400.939 627.276 405.435 654.864 414.427 678.979C423.419 702.684 437.724 721.281 457.343 734.769C476.961 747.848 502.506 754.387 533.978 754.387C544.604 754.387 553.801 753.979 561.566 753.161C569.741 752.344 577.098 751.322 583.637 750.096C590.585 748.87 597.125 747.644 603.256 746.417V640.968H514.972V574.142Z"
    class="stroke-theme stroke-[20px] transition-all"></path>
  <image
    y="330"
    x="225"
    height="490"
    clip-path="url(#clipping-g)"
    xlink:href="/hero-2.jpeg"
    filter="url(#image-filter)"
  />
  <rect
    y="330"
    x="225"
    width="500"
    height="500"
    clip-path="url(#clipping-g)"
    class="fill-[url(#gradient-dark)] dark:fill-[url(#gradient-light)]"></rect>
</svg>
