  <image
    class="saturate-0 dark:brightness-150 transition-all"
    y="330"
    x="225"
    height="490"
    clip-path="url(#clipping-g)"
    xlink:href="src/assets/photos/photo-grid-2.jpeg"
  />
  <rect
    y="330"
    x="225"
    width="500"
    height="500"
    clip-path="url(#clipping-g)"
    class="fill-[url(#gradient-dark)] dark:fill-[url(#gradient-light)]"></rect>
</svg>

