---
import { Image } from '@astrojs/image/components'
import photo from '../assets/photos/photo-grid-2.jpeg'
const { class: classes, imgClass} = Astro.props
---

<div role="img" class:list={['inline-block', classes]}>
  <Image src={photo} class:list={['object-cover block h-full w-auto aspect-[413/514]', imgClass]} height={800} format="webp" aria-hidden="true"/>
  
  <svg width="0" height="0" viewBox="0 0 413 514">
    <defs>
      <clipPath id="g-clip" clipPathUnits="objectBoundingBox">
        <path d="M223.6 232.6H412.6V486.7C386 495.567 358.7 502.333 330.7 507C302.7 511.667 270.967 514 235.5 514C185.1 514 142.4 503.967 107.4 483.9C72.4 463.833 45.8 434.667 27.6 396.4C9.39999 358.133 0.299988 311.467 0.299988 256.4C0.299988 204.133 10.5667 158.867 31.1 120.6C51.6333 82.3333 81.0333 52.7 119.3 31.7C158.033 10.7 205.167 0.199982 260.7 0.199982C287.767 0.199982 313.9 2.99999 339.1 8.6C364.767 13.7333 388.1 20.9666 409.1 30.3L378.3 103.8C362.433 95.8666 344 89.3333 323 84.2C302.467 78.6 281 75.8 258.6 75.8C224.533 75.8 195.133 83.2666 170.4 98.2C145.667 113.133 126.533 134.367 113 161.9C99.9333 188.967 93.4 220.933 93.4 257.8C93.4 293.267 98.5333 324.767 108.8 352.3C119.067 379.367 135.4 400.6 157.8 416C180.2 430.933 209.367 438.4 245.3 438.4C257.433 438.4 267.933 437.933 276.8 437C286.133 436.067 294.533 434.9 302 433.5C309.933 432.1 317.4 430.7 324.4 429.3V308.9H223.6V232.6Z"/>
      </clipPath>
    </defs>
  </svg>
</div>

<style>
  img {
    clip-path: url(#g-clip);
    object-position: 35%;
  }
  #g-clip{
    transform:scale(calc(1 / 413), calc(1 / 514));
  }
</style>
