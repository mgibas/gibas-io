---
import PageHeroM from './page-hero-m.astro'
import PageHeroG from './page-hero-g.astro'
import ThemeToggle from './theme-toggle.astro'
import IconMapPin from '../icons/map-pin.astro'
import IconGithub from '../icons/github.astro'
import IconTwitter from '../icons/twitter.astro'
const { location, class: classes } = Astro.props

const social = [
  {
    name: 'Twitter',
    url: 'https://twitter.com/gibasmaciej',
    Icon: IconTwitter,
  },
  {
    name: 'GitHub',
    url: 'https://github.com/mgibas',
    Icon: IconGithub,
  },
]
---



<header class:list={['flex items-center relative', classes]}>

  <div class="container">
    <div class="flex flex-col items-start w-full">
      <div class="flex text-base text-secondary gap-1 items-center">
        <IconMapPin class="text-tertiary w-5 h-5" />
        <span>{location}</span>
      </div>
      <div>
        <h1 class="text-6xl"><slot /></h1>
        <ul class="flex gap-4 text-tertiary mt-4">
          {
            social.map(({ url, name, Icon }) => (
              <li>
                <a href="url" class="hover:text-secondary transition-colors" target="_blank" rel="noopener noreferrer">
                  <span class="sr-only">{name}</span>
                  <Icon class="h-6 w-6 transition-transform hover:rotate-12" />
                </a>
              </li>
            ))
          }
          <li class="ml-auto">
            <ThemeToggle class="w-6 h-6 transition-all hover:rotate-12 hover:text-secondary" />
          </li>
        </ul>
      </div>
    </div>
    <div class="inline-block absolute top-1/2 right-0 -translate-y-[250%] sm:-translate-y-[170%] lg:-translate-y-[110%]" aria-hidden="true">
      <PageHeroM class="transition-all h-[100px] sm:h-[200px] lg:h-[325px]" imgClass="saturate-0" />
      <PageHeroG class="ralative transition-all h-[100px]  sm:h-[200px] lg:h-[325px] translate-x-[-33%] translate-y-[75%]" imgClass="saturate-0" />
    </div>
  </div>
</header>