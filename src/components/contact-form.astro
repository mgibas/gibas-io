---
import ArrowRight from '@icons/arrow-right.astro'

const { class: classes } = Astro.props
---

<form class:list={['flex flex-col gap-4', classes]} name="contact" netlify="true" action="/sent">
  <div class="flex flex-col gap-1">
    <label class="text-base font-medium" for="email">E-mail</label>
    <input
      class="rounded border border-zinc-400 px-4 py-2.5 leading-5 dark:bg-zinc-800"
      type="email"
      id="email"
      name="email"
      autocomplet="email"
      required
    />
  </div>
  <div class="flex flex-col gap-1">
    <label class="text-base font-medium" for="message">Message</label>
    <textarea
      class="rounded border border-zinc-400 px-4 py-2.5 leading-5 dark:bg-zinc-800"
      id="message"
      rows="3"
      name="message"
      type="textarea"
      required></textarea>
  </div>
  <button class="flex items-center gap-2 ml-auto rounded text-base leading-5">
    Send <ArrowRight class="h-5 w-5" />
  </button>
</form>
