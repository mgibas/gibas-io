---
const { class: classes } = Astro.props
---

<form class:list={['flex flex-col gap-4', classes]} name="contact" netlify="true" action="/sent">
  <div class="flex flex-col gap-1">
    <label class="text-base font-medium" for="email">E-mail</label>
    <input
      class="px-4 py-2.5 leading-5 rounded border border-zinc-400"
      type="email"
      id="email"
      autocomplet="email"
      required
    />
  </div>
  <div class="flex flex-col gap-1">
    <label class="text-base font-medium" for="message">Message</label>
    <textarea
      class="px-4 py-2.5 leading-5 rounded border border-zinc-400"
      id="message"
      rows="3"
      type="textarea"
      required></textarea>
  </div>
  <button class="ml-auto leading-5 rounded text-base">Send ➞</button>
</form>
