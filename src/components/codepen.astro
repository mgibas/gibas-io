---
const { class: classes, user = 'gibasmaciej', id } = Astro.props
---

<iframe
  class:list={[classes]}
  scrolling="no"
  title="Floated layout"
  src={`https://codepen.io/${user}/embed/${id}?default-tab=result&editable=true`}
  frameborder="no"
  loading="lazy"
  allowtransparency="true"
  allowfullscreen="true">
</iframe>
