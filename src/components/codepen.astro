---
const { class: classes, user = 'gibasmaciej', id } = Astro.props
---

<iframe
  class:list={[classes, 'clip-path-inset-[1.5px]']}
  scrolling="no"
  title="Floated layout"
  src={`https://codepen.io/${user}/embed/${id}?default-tab=result&editable=true&theme-id=dark`}
  frameborder="no"
  loading="lazy"
  allowtransparency="true"
  allowfullscreen="true">
    See the Pen <a href={`https://codepen.io/${user}/pen/${id}`}>
    Flexbox</a> by Maciej (<a href="https://codepen.io/${user}">@gibasmaciej</a>)
    on <a href="https://codepen.io">CodePen</a>.
</iframe>
