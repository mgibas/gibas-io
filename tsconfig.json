{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "types": ["node", "vite/client", "lib.dom"],
    "baseUrl": ".",
    "paths": {
      "@*": ["./*"],
      "@src/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"],
      "@styles/*": ["src/styles/*"],
      "@data/*": ["src/data/*"],
      "@icons/*": ["src/icons/*"],
      "@assets/*": ["src/assets/*"]
    }
  }
}
