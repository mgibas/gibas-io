{
  "name": "portfolio",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "run-p watch:*",
    "clean": "rm -rf ./_site",
    "watch:css": "tailwindcss -o ./_site/index.css --watch",
    "watch:eleventy": "eleventy --serve",
    "build:css": "tailwindcss -o ./_site/index.css",
    "build:eleventy": "eleventy",
    "build": "NODE_ENV=production run-s clean build:css build:css build:eleventy"
  },
  "author": "",
  "devDependencies": {
    "@11ty/eleventy": "^1.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.6.2",
    "prettier-plugin-tailwindcss": "^0.1.8",
    "tailwindcss": "^3.0.23"
  }
}
