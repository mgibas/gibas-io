{
  "name": "portfolio",
  "version": "1.0.0",
  "scripts": {
    "dev": "run-p watch:*",
    "clean": "rm -rf ./_site",
    "watch:css": "tailwindcss -i ./src/assets/css/index.css -o ./_site/index.css --watch",
    "watch:eleventy": "eleventy --serve",
    "build:css": "tailwindcss -i ./src/assets/css/index.css -o ./_site/index.css",
    "build:eleventy": "eleventy",
    "build": "NODE_ENV=production run-s clean build:css build:css build:eleventy"
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.5.0",
    "@tailwindcss/typography": "^0.5.2"
  },
  "devDependencies": {
    "prettier": "^2.6.2",
    "prettier-plugin-tailwindcss": "^0.1.10"
  }
}