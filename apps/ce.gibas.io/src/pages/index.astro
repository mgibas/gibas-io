---
import Layout from '@layouts/Layout.astro'
import PageFooter from '@gibas/components/page/page-footer'
import PageHeader from '@gibas/components/page/page-header'
import ContactForm from '@gibas/components/contact-form'
import Recipes from '@components/recipes.astro'
---

<Layout main-class="py-4 sm:py-8">
  <PageHeader
    slot="header"
    teaser="Essential web cook book"
    title="Custom Elements Recipes"
    subtitle="Recipes your mom would be proud of. Learn how to create custom elements from scratch!"
  />
  <Recipes />
  <ContactForm
    class="py-32"
    name="recipe-idea"
    title="Have an idea for a recipe?"
    subtitle="Send your idea so I can expand the cook book!"
  />
  <PageFooter class="py-8" slot="footer" />
</Layout>
