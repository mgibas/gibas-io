---
import '@assets/index.css'
import Pancakes from '@gibas/components/layouts/pancakes'
import SquaredPattern from '@components/squared-pattern.astro'
export interface LayoutProps {
  'main-class'?: string
}
const { 'main-class': mainClasses } = Astro.props
---

<Pancakes
  title="Custom Element Recipes"
  description="Explore a collection of custom element recipes to enhance your web development skills. Learn step-by-step with code examples and detailed instructions."
  main-class={`flex flex-col gap-4 ${mainClasses}`}
  containers>
  <slot name="head" slot="head" />
  <slot name="header" slot="header" />
  <SquaredPattern
    class="absolute inset-0 -z-10 h-screen w-screen stroke-gray-100 dark:stroke-gray-800 [mask-image:radial-gradient(100%_100%_at_top_left,white,transparent)]"
  />
  <slot />
  <slot name="footer" slot="footer" />
</Pancakes>
