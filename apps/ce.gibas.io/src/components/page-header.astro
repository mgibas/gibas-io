---
interface Props {
  class?: string
  title: string
  actionsBreakpoint?: string
}

const { title, class: classes } = Astro.props
const actionsWrapperClass = {
  default: 'flex',
  sm: 'hidden sm:flex',
  md: 'hidden md:flex',
  lg: 'hidden lg:flex',
  xl: 'hidden xl:flex',
}[Astro.props.actionsBreakpoint ?? 'default']
---

<div class:list={[classes]}>
  <div>
    <nav aria-label="Back to Custom Element Recipes">
      <a href="/" class="flex items-center text-sm font-medium text-secondary">
        <svg
          class="-ml-1 mr-1 size-5 shrink-0 text-secondary"
          viewBox="0 0 20 20"
          fill="currentColor"
          aria-hidden="true"
          data-slot="icon">
          <path
            fill-rule="evenodd"
            d="M11.78 5.22a.75.75 0 0 1 0 1.06L8.06 10l3.72 3.72a.75.75 0 1 1-1.06 1.06l-4.25-4.25a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 0Z"
            clip-rule="evenodd"></path>
        </svg>
        Custom Element Recipes
      </a>
    </nav>
  </div>
  <div class="mt-2 gap-4 flex items-center justify-between">
    <div class="min-w-0 flex-1">
      <h1 class="text-2xl/7 font-bold text-primary sm:truncate sm:text-3xl sm:tracking-tight">{title}</h1>
    </div>
    <div class={`shrink-0 md:ml-4 md:mt-0 gap-2 ${actionsWrapperClass}`}>
      <slot name="actions" />
    </div>
  </div>
</div>
