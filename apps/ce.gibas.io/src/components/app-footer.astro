---
import Link from '@components/link.astro'
import LogoAstro from '@gibas/components/icons/logo-astro'
import LogoTailwind from '@gibas/components/icons/logo-tailwind'
import LogoTs from '@gibas/components/icons/logo-ts'
---

<footer class="bg-theme text-sm text-secondary">
  <div class="flex flex-col gap-2">
    <span>Made by <Link href="https://gibas.io/">gibas.io</Link></span>
    <ul class="flex gap-4">
      <li class="inline-flex gap-2 items-center">
        <LogoAstro class="w-4 h-4" /> Astro
      </li>
      <li class="inline-flex gap-2 items-center">
        <LogoTs class="w-4 h-4" /> Typescript
      </li>
      <li class="inline-flex gap-2 items-center">
        <LogoTailwind class="w-4 h-4" /> Tailwindcss
      </li>
    </ul>
  </div>
</footer>
