---
export interface Props {
  class?: string
}
const { class: className } = Astro.props
---

<div class={`py-24 sm:py-32 ${className}`}>
  <div class="max-w-2xl lg:mx-0">
    <p
      class="text-base/7 font-semibold bg-gradient-to-r from-sunset-orange via-sunset-violet to-sunset-violet bg-clip-text text-transparent">
      Essential web cook book
    </p>
    <h1 class="mt-2 text-5xl font-semibold tracking-tight text-gray-900 sm:text-7xl">Custom Elements Recipes</h1>
    <p class="mt-8 text-pretty text-lg font-medium text-gray-500 sm:text-xl/8">
      Recipes your mom would be proud of. Learn how to create custom elements from scratch!
    </p>
  </div>
</div>
