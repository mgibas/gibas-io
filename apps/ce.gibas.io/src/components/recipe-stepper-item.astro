---
import type { Step, Recipe } from '@/types.js'
import RecipeStepDescription from '@components/recipe-step-description.astro'

export interface Props {
  recipe: Recipe
  stepId: number
  step: Step
  isCurrent: boolean
  isCompleted: boolean
  isLast: boolean
}
const { recipe, stepId, step, isCurrent, isCompleted, isLast } = Astro.props
const href = `/recipes/${recipe.slug}/steps/${stepId}`
const Tag = isCurrent ? 'span' : 'a'
---

<li class="md:hidden p-1">
  <Tag href={href} class="relative flex items-center justify-center" aria-current="step">
    {
      isCurrent && (
        <span class="absolute flex size-5 p-px" aria-hidden="true">
          <span class="size-full rounded-full bg-rose-200" />
        </span>
      )
    }
    <span
      class={`relative block size-2.5 rounded-full ${isCompleted || isCurrent ? 'bg-rose-600' : 'bg-gray-200'}`}
      aria-hidden="true"></span>
    <span class="sr-only">{step.title}</span>
  </Tag>
</li>

<li class={`relative hidden md:flex flex-col gap-2 ${!isLast ? 'pb-10' : ''}`}>
  {
    !isLast && (
      <div
        class={`absolute left-4 top-4 -ml-px mt-0.5 h-full w-0.5  ${isCompleted ? 'bg-rose-300' : 'bg-gray-300'}`}
        aria-hidden="true"
      />
    )
  }

  <Tag href={href} class="group relative flex items-start" aria-current={isCurrent ? 'step' : undefined}>
    <span class="flex h-9 items-center" aria-hidden="true">
      <span
        class={`relative z-10 flex size-8 items-center justify-center rounded-full ${isCurrent ? 'border-2 border-rose-300 bg-white' : isCompleted ? 'bg-white border-rose-300 border-2' : 'border-2 border-gray-300 bg-white group-hover:border-gray-400'}`}>
        {
          isCurrent ? (
            <span class="size-2.5 rounded-full bg-rose-500" />
          ) : isCompleted ? (
            <svg
              class="size-5 text-rose-600"
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
              data-slot="icon">
              <path
                fill-rule="evenodd"
                d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
                clip-rule="evenodd"
              />
            </svg>
          ) : (
            <span class="size-2.5 rounded-full bg-transparent group-hover:bg-gray-300" />
          )
        }
      </span>
    </span>
    <span class="ml-4 pt-2 flex min-w-0 flex-col">
      <span class:list={['text-sm font-medium', isCurrent || isCompleted ? 'text-primary' : 'text-secondary']}
        >{step.title}</span
      >
      {isCurrent && <RecipeStepDescription class="text-sm text-gray-500" description={step.description} />}
    </span>
  </Tag>
</li>
