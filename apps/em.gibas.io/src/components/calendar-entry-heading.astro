---
import type { Theme } from '@gibas/components/types'

interface CalendarEntryHeadingProps {
  copy: string
  tag?: 'h2' | 'h3' | 'h4' | 'h5' | 'h6'
  startTime: string
  endTime: string
  theme?: Theme | 'sunset'
  class?: string
}

const {
  copy,
  startTime,
  endTime,
  tag: Tag = 'h2',
  theme = 'yellow',
  class: classes = '',
} = Astro.props as CalendarEntryHeadingProps

const themeClasses = {
  yellow: 'before:bg-yellow-400',
  purple: 'before:bg-purple-400',
  teal: 'before:bg-teal-400',
  sunset: 'before:bg-gradient-to-b before:from-sunset-orange before:to-sunset-violet',
} satisfies Record<Theme | 'sunset', string>
---

<Tag class:list={['rounded-lg border border-theme -ml-7', classes]}>
  <div
    class:list={[
      'relative flex flex-col gap-1 p-2 pl-7 before:absolute before:left-1 before:top-1 before:bottom-1 before:w-2 before:rounded-full',
      themeClasses[theme],
    ]}>
    <div aria-hidden="true" class="text-sm text-secondary">
      {startTime} - {endTime}
    </div>
    <span class="font-medium text-primary m-0">{copy}</span>
  </div>
</Tag>
