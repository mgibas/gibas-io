---
import { Image } from 'astro:assets'
import Link from '@gibas/components/link'
export interface ResourcesBook {
  title: string
  author: string
  summary: string
  url: string
  cover: Promise<{ default: ImageMetadata }>
}
const { title, url, author, summary, cover } = Astro.props as ResourcesBook
---

<li class="flex flex-col gap-4 py-5 my-0 px-0 sm:flex-row">
  <Image class="w-32 flex-none rounded-lg mt-0 mb-auto" src={cover} alt={title} width={128} />

  <div class="flex-auto">
    <div class="flex flex-col gap-1">
      <Link href={url}>{title}</Link>
      <span class="flex-none text-sm text-secondary italic">{author}</span>
    </div>
    <p>{summary}</p>
  </div>
</li>
