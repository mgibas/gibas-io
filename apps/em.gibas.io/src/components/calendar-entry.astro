---
import type { Theme } from '@gibas/components/types'

interface CalendarEntryProps {
  title: string
  'title-tag'?: 'div' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6'
  startTime: string
  endTime: string
  size?: 'md' | 'lg'
  theme?: Theme | 'gray'
  class?: string
  role?: 'presentation' | null
}

const {
  title,
  startTime,
  endTime,
  theme = 'yellow',
  class: classes = '',
  role = null,
} = Astro.props as CalendarEntryProps

const themeClasses = {
  yellow: 'before:bg-yellow-400',
  purple: 'before:bg-purple-400',
  teal: 'before:bg-teal-400',
  gray: 'before:bg-zinc-400',
} satisfies Record<Theme | 'gray', string>
---

<div role={role} class:list={['rounded-lg border border-theme ', classes]}>
  <div
    class:list={[
      'relative flex flex-col h-full gap-1 p-1 pl-4 sm:p-2 sm:pl-7 before:absolute before:left-1 before:top-1 before:bottom-1 before:w-1 sm:before:w-2 before:rounded-full',
      themeClasses[theme],
    ]}>
    <div class="text-xs text-secondary md:text-sm">{startTime} - {endTime}</div>
    <div class="text-sm font-medium text-primary md:text-base">{title}</div>
  </div>
</div>
