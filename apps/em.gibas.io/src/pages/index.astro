---
import Layout from '@layouts/Layout.astro'
import PageHeroHeader from '@gibas/components/page/page-hero-header'
import PageFooter from '@gibas/components/page/page-footer'
import ContactForm from '@gibas/components/contact-form'
import BentoGrid from '@gibas/components/collections/bento-grid'
import BentoGridItem from '@gibas/components/collections/bento-grid-item'
import { getCollection } from 'astro:content'

const articles = await getCollection('articles')
---

<Layout main-class="py-4 sm:py-8">
  <PageHeroHeader
    slot="header"
    teaser="No BS guide"
    title="Engineering Manager 101"
    subtitle="Become a manager your mom always wanted you to be!"
  />

  <BentoGrid>
    {articles.map((article) => <BentoGridItem title={article.data.title} description={article.data.subtitle} />)}
    <BentoGridItem title="TODO" description="TODO" />
  </BentoGrid>

  <ContactForm
    class="py-32"
    name="recipe-idea"
    title="What else should I cover?"
    subtitle="Send your idea so I can expand this guide!"
  />
  <PageFooter class="py-8" slot="footer" />
</Layout>
