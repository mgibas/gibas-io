---
export interface CodepenProps {
  class?: string
  user?: string
  id: string
}
const { class: classes, user = 'gibasmaciej', id } = Astro.props
const Tag = 'iframe'
---

<Tag
  class:list={[classes, 'h-full w-full']}
  title="Floated layout"
  src={`https://codepen.io/${user}/embed/${id}?default-tab=result&editable=true&theme-id=light`}
  loading="lazy"
  allowtransparency="true"
  allowfullscreen="true">
  See the Pen <a href={`https://codepen.io/${user}/pen/${id}`}> Flexbox</a> by Maciej (<a
    href="https://codepen.io/${user}">@gibasmaciej</a
  >) on <a href="https://codepen.io">CodePen</a>.
</Tag>
