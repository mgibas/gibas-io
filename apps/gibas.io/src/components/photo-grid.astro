---
import { Picture } from 'astro:assets'
import photo1 from '@assets/photos/photo-grid-1.webp'
import photo2 from '@assets/photos/photo-grid-2.webp'
import photo2Overlay from '@assets/photos/photo-grid-2-overlay.webp'
import photo3 from '@assets/photos/photo-grid-3.webp'
import photo4 from '@assets/photos/photo-grid-6.jpeg'
import photo4Overlay from '@assets/photos/photo-grid-6-overlay.png'
import photo5 from '@assets/photos/photo-grid-5.webp'
import photo6 from '@assets/photos/photo-grid-4.webp'
import photo6Overlay from '@assets/photos/photo-grid-4-overlay.webp'
import photo7 from '@assets/photos/photo-grid-7.webp'
import photo7Overlay from '@assets/photos/photo-grid-7-overlay.webp'
import photo8 from '@assets/photos/photo-grid-8.webp'
export interface PhotoGridProps {
  class?: string
  imgClass?: string
}

const { class: classes, imgClass } = Astro.props

const widths = [320, 640, 960, 1280]
const sizes = '(min-width: 768px) 25vw, 300px'

const photos = [
  { src: photo1, alt: 'Me, laughing at a table in a café.' },
  {
    src: photo2,
    overlaySrc: photo2Overlay,
    position: 'object-[50%_70%]',
    alt: 'Standing on a rock in a red canyon at Zion National Park.',
  },
  { src: photo3, position: 'object-[50%_66%]', alt: 'Walking into the ocean at sunset with my two kids.' },
  { src: photo4, overlaySrc: photo4Overlay, alt: 'Climbing at my local gym.' },
  { src: photo5, alt: 'My two kids posing on the Bonneville Salt Flats.' },
  { src: photo6, overlaySrc: photo6Overlay, alt: 'Stirring coffee during pour-over brew.' },
  { src: photo7, overlaySrc: photo7Overlay, alt: 'Library, open laptop with a visible code on the screen.' },
  { src: photo8, alt: 'Me and my wife smiling next to a graffiti heart.' },
]
---

<div class:list={['flex gap-2 overflow-x-scroll md:block md:columns-4', classes]}>
  {
    photos.map(({ src, overlaySrc, alt, position = 'object-center' }) => (
      <div tabindex="0" class="group relative mb-2 max-h-80 shrink-0 basis-[300px] md:aspect-video md:max-h-100 md:odd-alternate:aspect-square md:odd-alternate:max-h-150 lg:max-h-150 lg:odd-alternate:max-h-200">
        <Picture
          class:list={[
            'h-full w-full object-cover saturate-0 transition-all duration-500 ease-in-out group-hover:saturate-100 group-focus-within:saturate-100 group-active:saturate-100 dark:brightness-150 dark:group-hover:brightness-100 dark:group-focus-within:brightness-100 dark:group-active:brightness-100',
            position,
            imgClass,
          ]}
          src={src}
          alt={alt}
          quality="high"
          widths={widths}
          sizes={sizes}
          loading="lazy"
          formats={['avif', 'webp']}
        />
        {overlaySrc && (
          <Picture
            class:list={[
              'absolute inset-0 h-full w-full object-cover transition-all duration-500 ease-in-out group-hover:opacity-0 group-focus-within:opacity-0 group-active:opacity-0 dark:brightness-150',
              position,
            ]}
            src={overlaySrc}
            alt={alt}
            quality="high"
            widths={widths}
            sizes={sizes}
            aria-hidden="true"
            loading="lazy"
            formats={['avif', 'webp']}
          />
        )}
      </div>
    ))
  }
</div>
