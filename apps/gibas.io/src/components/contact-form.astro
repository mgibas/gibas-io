---
import ArrowRight from '@gibas/components/icons/arrow-right'
import Input from '@gibas/components/input'
import Textarea from '@gibas/components/textarea'
export interface ContactFormProps {
  class?: string
}

const { class: classes } = Astro.props
---

<form class:list={['flex flex-col gap-4', classes]} name="contact" data-netlify="true" action="/sent">
  <div class="flex flex-col gap-1">
    <label class="text-base font-medium" for="email">E-mail</label>
    <Input type="email" id="email" name="email" autocomplete="email" required />
  </div>
  <div class="flex flex-col gap-1">
    <label class="text-base font-medium" for="message">Message</label>
    <Textarea id="message" name="message" required />
  </div>
  <button class="flex items-center gap-2 ml-auto rounded text-base leading-5">
    Send <ArrowRight class="h-5 w-5" />
  </button>
</form>
