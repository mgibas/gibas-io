---
import { getImage } from 'astro:assets'
import photo1 from '@assets/photos/photo-grid-1.webp'
import photo2 from '@assets/photos/photo-grid-2.webp'
export interface PageHeroProps {
  class?: string
}
const { class: classes } = Astro.props
const optimizedPhoto1 = await getImage({ src: photo1, format: 'webp', width: 800 })
const optimizedPhoto2 = await getImage({ src: photo2, format: 'webp', width: 500 })
---

<svg class:list={['overflow-visible', classes]} viewBox="0 0 743 832" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <clipPath id="clipping-m"><use xlink:href="#letter-m"></use></clipPath>
    <clipPath id="clipping-g"><use xlink:href="#letter-g"></use></clipPath>
    <linearGradient id="gradient-light" x1="0" x2="0" y1="0" y2="1" gradientTransform="rotate(35)">
      <stop offset="0%" stop-color="white" stop-opacity=".7"></stop>
      <stop offset="40%" stop-color="white" stop-opacity=".09"></stop>
      <stop offset="80%" stop-color="white" stop-opacity=".6"></stop>
      <stop offset="100%" stop-color="white"></stop>
    </linearGradient>
    <linearGradient id="gradient-dark" x1="0" x2="0" y1="0" y2="1" gradientTransform="rotate(35)">
      <stop offset="0%" stop-color="black" stop-opacity=".7"></stop>
      <stop offset="40%" stop-color="black" stop-opacity=".09"></stop>
      <stop offset="80%" stop-color="black" stop-opacity=".6"></stop>
      <stop offset="100%" stop-color="black"></stop>
    </linearGradient>
    <filter id="image-filter">
      <feColorMatrix in="SourceGraphic" type="saturate" values="0"></feColorMatrix>
    </filter>
  </defs>

  <path
    id="letter-m"
    d="M0 450V0H141.3L214.4 206.6Q219 221.1 224.8 244Q230.7 267 236.8 293.6Q242.8 320.1 248.1 345.2Q253.4 370.3 256.7 388.7H238.9Q242.2 370.6 247.5 345.7Q252.8 320.7 258.8 294.2Q264.9 267.6 270.8 244.3Q276.6 221.1 281.2 206.6L353.1 0H495V450H402.3V238Q402.3 223.2 402.7 201.1Q403.2 179.1 403.9 153.6Q404.7 128.1 405.3 102.2Q405.9 76.4 406.2 53.5H411.9Q406.2 78.5 399.3 105.3Q392.3 132 385.2 157Q378.1 182.1 371.8 203.1Q365.4 224.1 360.9 238L286.3 450H208.7L132.9 238Q128.4 224.1 122 203.4Q115.7 182.7 108.6 157.7Q101.5 132.6 94.2 105.9Q87 79.1 80.6 53.5H87.6Q87.9 75.2 88.5 100.9Q89.1 126.5 89.8 152.4Q90.6 178.2 91.1 200.4Q91.5 222.6 91.5 238V450Z">
  </path>
  <image
    x="-300"
    y="-215"
    width="800"
    clip-path="url(#clipping-m)"
    xlink:href={optimizedPhoto1.src}
    filter="url(#image-filter)"
  />
  <rect
    width="500"
    height="500"
    clip-path="url(#clipping-m)"
    class="fill-[url(#gradient-dark)] dark:fill-[url(#gradient-light)]"></rect>

  <path
    id="letter-g"
    d="M548.3 832.1Q485.2 832.1 437.6 804.1Q390.1 776.2 363.3 724.4Q336.6 672.6 336.6 601.6Q336.6 528.6 364.4 476.8Q392.2 425 439.6 397.5Q487 370 546.2 370Q584.3 370 617 381Q649.8 392 675.3 412.3Q700.8 432.5 717 460.2Q733.1 487.8 738 521.3H644.4Q639.5 505 630.9 492.2Q622.3 479.3 610.1 470.3Q597.8 461.2 582.1 456.5Q566.4 451.8 547.7 451.8Q513 451.8 486.4 469.2Q459.8 486.6 445 519.8Q430.2 553 430.2 600.7Q430.2 648.5 444.9 681.8Q459.5 715.2 486.1 732.7Q512.7 750.2 548.9 750.2Q581.5 750.2 604.8 738.5Q628 726.7 640.6 704.8Q653.1 682.9 653.1 653.6L672.4 656.3H555.3V586.2H742.5V642.4Q742.5 701.6 717.4 744Q692.4 786.5 648.6 809.3Q604.8 832.1 548.3 832.1Z"
    class="stroke-theme stroke-[52px] transition-all"
    stroke-linejoin="round"></path>
  <image
    y="94"
    x="333"
    width="520"
    clip-path="url(#clipping-g)"
    xlink:href={optimizedPhoto2.src}
    filter="url(#image-filter)"
  />
  <rect
    y="330"
    x="225"
    width="530"
    height="510"
    clip-path="url(#clipping-g)"
    class="fill-[url(#gradient-dark)] dark:fill-[url(#gradient-light)]"></rect>
</svg>
