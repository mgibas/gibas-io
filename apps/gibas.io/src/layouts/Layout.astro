---
import '@assets/styles.css'
import Pancakes from '@gibas/components/layouts/pancakes'
export interface LayoutProps {
  title: string
}
const { title } = Astro.props
---

<Pancakes
  title={title}
  description="Maciej Gibas, Personal website, portfolio, frontend engineer, developer, designer, leader, manager."
  class="text-xl"
  containers
  main-class="prose-lg prose">
  <slot name="header" slot="header" />
  <slot />
  <slot name="footer" slot="footer" />
</Pancakes>
