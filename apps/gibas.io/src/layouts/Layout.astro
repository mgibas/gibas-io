---
import '@assets/styles.css'
import Pancakes from '@gibas/components/layouts/pancakes'
import { personJsonLd } from '@data/json-ld'
export interface LayoutProps {
  title: string
}
const { title } = Astro.props
---

<Pancakes
  title={title}
  description="Maciej Gibas, Personal website, portfolio, frontend engineer, developer, designer, leader, manager."
  class="text-xl"
  containers
  main-class="prose-lg prose">
  <Fragment slot="head">
    <link rel="alternate" type="text/markdown" href="/index.md" />
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  </Fragment>
  <slot name="header" slot="header" />
  <slot />
  <slot name="footer" slot="footer" />
</Pancakes>
