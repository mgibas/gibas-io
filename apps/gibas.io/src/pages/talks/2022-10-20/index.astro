---
import Layout from '@layouts/SlidesDeck.astro'
import Slide from '@components/slide-deck/slide.astro'
import Link from '@components/slide-deck/link.astro'
import List from '@components/slide-deck/list.astro'
import ListItem from '@components/slide-deck/list-item.astro'
import SlideImage from '@components/slide-deck/slide-image.astro'
import FlatList from '@components/slide-deck/flat-list.astro'
import FlatListItem from '@components/slide-deck/flat-list-item.astro'
import Codepen from '@components/codepen.astro'
import ContentFrame from '@components/slide-deck/content-frame.astro'

import SlideAbout from '@components/slides/slide-about.astro'
import SlideBye from '@components/slides/slide-bye.astro'

import under from '@assets/talks/2022-10-20/under.webp'
import sideBySide from '@assets/talks/2022-10-20/side-by-side.webp'
import columns from '@assets/talks/2022-10-20/columns.webp'
import singleAxis from '@assets/talks/2022-10-20/single-axis.webp'
import twoAxis from '@assets/talks/2022-10-20/two-axis.webp'
import wrap1 from '@assets/talks/2022-10-20/wrap-1.webp'
import wrap2 from '@assets/talks/2022-10-20/wrap-2.webp'
import gridWrap1 from '@assets/talks/2022-10-20/grid-wrap-1.webp'
import gridWrap2 from '@assets/talks/2022-10-20/grid-wrap-2.webp'
import gridWrap3 from '@assets/talks/2022-10-20/grid-wrap-3.webp'
import subGrids from '@assets/talks/2022-10-20/subgrids.webp'
import masonry from '@assets/talks/2022-10-20/masonry.webp'
---

<Layout title="Talks - CSS Layouts">
  <Slide level="1" title="CSS Layouts" title-secondary="Frontend Awesome!" title-tertiary="10/20/2022" />

  <SlideAbout />

  <section>
    <Slide level="2" title="Back in the_day" alt />

    <Slide level="3" title="Tables" title-secondary="Simple and effective">
      <ContentFrame><Codepen id="jOxvBrK" /></ContentFrame>

      <FlatList slot="contentSecondary">
        <FlatListItem>First standard layout technique</FlatListItem>
        <FlatListItem>Netscape 1993</FlatListItem>
        <FlatListItem>HTML 3.2 1997</FlatListItem>
        <FlatListItem><Link href="https://www.spacejam.com/1996/jam.htm">spacejam</Link></FlatListItem>
      </FlatList>
    </Slide>

    <Slide level="3" title="Floats" title-secondary="Nooooo!!! 😱">
      <ContentFrame><Codepen id="ExLeoMP" /></ContentFrame>
      <FlatList slot="contentSecondary">
        <FlatListItem>First css layout technique</FlatListItem>
        <FlatListItem>Netscape ~1998</FlatListItem>
      </FlatList>
    </Slide>

    <Slide level="3" title="Grid_System" title-secondary="Responsiveness" alt>
      <ContentFrame><Codepen id="abGaYVR" /></ContentFrame>
      <FlatList slot="contentSecondary">
        <FlatListItem>RESPONSIVE</FlatListItem>
        <FlatListItem>iPhone 2007</FlatListItem>
        <FlatListItem>bootstrap 1.0 2011</FlatListItem>
      </FlatList>
    </Slide>
  </section>

  <section>
    <Slide level="2" title="Current o_ptions" />

    <Slide level="3" title="Block & Inline" title-secondary="Back to basics">
      <ContentFrame><Codepen id="KKRGozz" /></ContentFrame>
      <FlatList slot="contentSecondary">
        <FlatListItem>No wrapper</FlatListItem>
        <FlatListItem>maybe no css</FlatListItem>
        <FlatListItem>mix and match</FlatListItem>
      </FlatList>
    </Slide>

    <Slide level="3" title="Columns" title-secondary="Newspaper columns" alt>
      <ContentFrame><Codepen id="gOzdJLj" /></ContentFrame>
      <FlatList slot="contentSecondary">
        <FlatListItem>Dominantly "articles"</FlatListItem>
        <FlatListItem>break inside</FlatListItem>
        <FlatListItem>no horizontal gap</FlatListItem>
        <FlatListItem>no column wraper</FlatListItem>
      </FlatList>
    </Slide>

    <Slide level="3" title="Flexbox" title-secondary="Content content content!">
      <ContentFrame><Codepen id="poVxLxw" /></ContentFrame>
      <FlatList slot="contentSecondary">
        <FlatListItem>Content focused</FlatListItem>
        <FlatListItem>single axis</FlatListItem>
        <FlatListItem>feature rich</FlatListItem>
        <FlatListItem>gap</FlatListItem>
        <FlatListItem>responsivenes</FlatListItem>
        <FlatListItem>reverse...a11y</FlatListItem>
      </FlatList>
    </Slide>

    <Slide level="3" title="CSS Grid" title-secondary="Second axis of flexbox">
      <ContentFrame><Codepen id="dyegqLp" /></ContentFrame>
      <FlatList slot="contentSecondary">
        <FlatListItem>Layout focused</FlatListItem>
        <FlatListItem>two axes</FlatListItem>
        <FlatListItem>feature rich</FlatListItem>
      </FlatList>
    </Slide>
  </section>

  <section>
    <Slide level="2" title="What When" alt />

    <Slide level="3" title="Under" title-secondary="Stacked blocks">
      <ContentFrame center><SlideImage src={under} alt="One element under another example." /></ContentFrame>

      <FlatList slot="contentSecondary">
        <FlatListItem>Content base height</FlatListItem>
        <FlatListItem>no wrapper needed</FlatListItem>
        <FlatListItem>no css</FlatListItem>
        <FlatListItem>✅ block</FlatListItem>
      </FlatList>
    </Slide>

    <Slide level="3" title="Side by side" title-secondary="Sticky blocks">
      <ContentFrame><SlideImage src={sideBySide} alt="One element next to another example." /></ContentFrame>

      <FlatList slot="contentSecondary">
        <FlatListItem>Content base size</FlatListItem>
        <FlatListItem>no wrapper needed</FlatListItem>
        <FlatListItem>no css</FlatListItem>
        <FlatListItem>✅ inline</FlatListItem>
        <FlatListItem>✅ inline block</FlatListItem>
      </FlatList>
    </Slide>

    <Slide level="3" title="Simple columns">
      <ContentFrame><SlideImage src={columns} alt="Columns example." /></ContentFrame>

      <FlatList slot="contentSecondary">
        <FlatListItem>Newspaper columns</FlatListItem>
        <FlatListItem>no column wrappers</FlatListItem>
        <FlatListItem>best for breakable content</FlatListItem>
        <FlatListItem>✅ columns</FlatListItem>
      </FlatList>
    </Slide>

    <Slide level="3" title="Single axis" alt>
      <ContentFrame><SlideImage src={singleAxis} alt="Single axis example." /></ContentFrame>

      <FlatList slot="contentSecondary">
        <FlatListItem>"Ratio" based size</FlatListItem>
        <FlatListItem>✅ flexbox</FlatListItem>
      </FlatList>
    </Slide>

    <Slide level="3" title="Two axes" alt>
      <ContentFrame><SlideImage src={twoAxis} alt="Two axes example." /></ContentFrame>

      <FlatList slot="contentSecondary">
        <FlatListItem>Grid focused</FlatListItem>
        <FlatListItem>✅ grid</FlatListItem>
      </FlatList>
    </Slide>

    <Slide level="3" title="Wrapping" auto-animate>
      <ContentFrame>
        <div>
          <SlideImage src={wrap1} alt="Wrapping before example." />
          <SlideImage class="fragment" src={wrap2} alt="Wrapping after example." />
        </div>
      </ContentFrame>
      <FlatList slot="contentSecondary">
        <FlatListItem>Responsive</FlatListItem>
        <FlatListItem>Two dimensional gap</FlatListItem>
        <FlatListItem>✅ Flexbox</FlatListItem>
      </FlatList>
    </Slide>

    <Slide level="3" title="Wrapping" alt auto-animate>
      <ContentFrame>
        <div class="r-stack">
          <SlideImage src={gridWrap1} alt="Grid wrapping before example." />
          <SlideImage class="fragment" src={gridWrap2} alt="Grid wrapping after example." />
          <SlideImage class="fragment" src={gridWrap3} alt="Grid wrapping flex after example." />
        </div>
      </ContentFrame>
      <FlatList slot="contentSecondary">
        <FlatListItem>✅ Flexbox</FlatListItem>
      </FlatList>
    </Slide>
  </section>

  <section>
    <Slide level="2" title="What_is coming" title-secondary="Or is here already!" />

    <Slide level="3" title="Sub grids" title-secondary="No layout is imposible" auto-animate>
      <ContentFrame><Codepen id="LYmMLKB" /></ContentFrame>
      <FlatList slot="contentSecondary">
        <FlatListItem>Safari and Firefox</FlatListItem>
      </FlatList>
    </Slide>

    <Slide level="3" title="Sub grids" title-secondary="Even this is possible" alt auto-animate>
      <ContentFrame><SlideImage class="!max-h-[25vh]" src={subGrids} alt="Subgrid example." /></ContentFrame>
      <FlatList slot="contentSecondary">
        <FlatListItem>Aligned columns</FlatListItem>
        <FlatListItem>content based and fixed columns</FlatListItem>
        <FlatListItem>row (item) wrapper</FlatListItem>
        <FlatListItem>spaced rows</FlatListItem>
      </FlatList>
    </Slide>

    <Slide level="3" title="Masonry" title-secondary="Bye bye JavaScript" auto-animate>
      <ContentFrame><Codepen id="gOzZxgb" /></ContentFrame>
      <FlatList slot="contentSecondary">
        <FlatListItem>Photo galery</FlatListItem>
        <FlatListItem>pintrest layout</FlatListItem>
        <FlatListItem>still draft :(</FlatListItem>
      </FlatList>
    </Slide>

    <Slide level="3" title="Masonry" auto-animate alt>
      <ContentFrame><SlideImage src={masonry} alt="Masonry example." /></ContentFrame>
    </Slide>

    <Slide level="3" title="Container queries" title-secondary="Holy grail">
      <ContentFrame><Codepen id="zYjyJOP" /></ContentFrame>
      <FlatList slot="contentSecondary">
        <FlatListItem>Closer to the design</FlatListItem>
        <FlatListItem>better reusability</FlatListItem>
        <FlatListItem>web apps</FlatListItem>
      </FlatList>
    </Slide>
  </section>

  <Slide level="2" title="Resources">
    <List>
      <ListItem>
        <div>
          <Link href="http://grid-layout.com/history.html">Web layout history</Link>
        </div>
        <div class="text-lg text-secondary">Steven D. Anderson • grid-layout.com</div>
      </ListItem>
      <ListItem>
        <div>
          <Link href="https://css-tricks.com/in-defense-of-tables-and-floats-in-modern-day-development/">
            In Defense of Tables and Floats in Modern Day Development
          </Link>
        </div>
        <div class="text-lg text-secondary">John Macpherson • css-tricks.com</div>
      </ListItem>

      <ListItem>
        <div>
          <Link href="https://css-tricks.com/snippets/css/a-guide-to-flexbox/">A Complete Guide to Flexbox</Link>
        </div>
        <div class="text-lg text-secondary">Chris Coyier • css-tricks.com</div>
      </ListItem>
      <ListItem>
        <div>
          <Link href="https://css-tricks.com/snippets/css/complete-guide-grid/">A Complete Guide to Grid</Link>
        </div>
        <div class="text-lg text-secondary">Chris House • css-tricks.com</div>
      </ListItem>
      <ListItem>
        <div>
          <Link href="https://stackoverflow.com/a/55073039">Advantage Flexbox</Link>
        </div>
        <div class="text-lg text-secondary">Michael Benjamin • stackoverflow.com</div>
      </ListItem>
      <ListItem>
        <div>
          <Link href="https://www.smashingmagazine.com/native-css-masonry-layout-css-grid/">
            Native CSS Masonry Layout In CSS Grid
          </Link>
        </div>
        <div class="text-lg text-secondary">Rachel Andrew • smashingmagazine.com</div>
      </ListItem>
      <ListItem>
        <div>
          <Link href="https://1linelayouts.glitch.me">1-Line Layouts</Link>
        </div>
        <div class="text-lg text-secondary">Una • glitch.me</div>
      </ListItem>
    </List>
  </Slide>

  <SlideBye />
</Layout>
