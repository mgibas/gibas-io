---
import Layout from '@layouts/Layout.astro'
import PageFooter from '@gibas/components/page/page-footer'
import ContactForm from '@gibas/components/contact-form'
import PageHeader from '@components/page-header.astro'
import Typewriter from '@components/typewriter.astro'
import PhotoGrid from '@components/photo-grid.astro'
import Link from '@gibas/components/link'
import ArrowRight from '@gibas/components/icons/arrow-right'
import { getEntry, render } from 'astro:content'
import { getOrderedCollection } from '@src/lib/content'
import { profile } from '@data/profile'

const section = async (id: string) => {
  const entry = await getEntry('sections', id)
  if (!entry) throw new Error(`Missing section: ${id}`)
  return { data: entry.data, Content: (await render(entry)).Content }
}
const about = await section('about')
const approach = await section('approach')
const personal = await section('personal')
const work = await section('work')
const contact = await section('contact')
const projects = await Promise.all(
  (await getOrderedCollection('projects')).map(async (entry) => ({ data: entry.data, Content: (await render(entry)).Content })),
)
---

<Layout title="Maciej Gibas">
  <PageHeader class="h-screen" slot="header" location={`${profile.location.city}, ${profile.location.region}`}>
    <h1 class="text-6xl/[1.05] font-[510] tracking-[-0.03em]">
      <div>Hello <span class="inline-block origin-[70%_70%] animate-wave">👋🏼</span></div>
      <div>I'm Maciej Gibas</div>
      <Typewriter class="mt-4 text-xl font-normal tracking-normal text-secondary" prefix={profile.rolePrefix} copy={profile.roles} />
    </h1>
    <h2 class="sr-only">{profile.description}</h2>
  </PageHeader>

  <h2>{about.data.label}</h2>

  <h3>{about.data.title}</h3>
  <about.Content />

  <h3>{approach.data.title}</h3>
  <approach.Content />

  <section class="container-bleed bg-theme-inverted mt-12 pb-12 overflow-auto">
    <div class="prose-inverted container">
      <h3>{personal.data.title}</h3>
      <personal.Content />
    </div>
    <PhotoGrid class="not-prose mt-6" />
  </section>

  <section>
    <h3>{work.data.title}</h3>
    <work.Content />

    <ul class="mt-8 mb-0 p-0 list-none grid gap-8 sm:gap-16 sm:grid-cols-3">
      {
        projects.map(({ data, Content }) => (
          <li class="grid grid-rows-[auto_1fr_auto] mt-0 mb-0 p-0">
            <Link class="no-underline" bare href={data.href}>
              {data.title}
            </Link>
            <div class="text-secondary [&_a]:font-normal [&_p]:my-0">
              <Content />
            </div>
            <Link class="mt-2 flex items-center gap-2" bare href={data.href}>
              Check it out <ArrowRight class="h-5 w-5" />
            </Link>
          </li>
        ))
      }
    </ul>
  </section>

  <h2>{contact.data.label}</h2>
  <ContactForm class="-mt-12" name="contact" title={contact.data.title} title-tag="h3">
    <div class="[&_p]:my-0" slot="subtitle">
      <contact.Content />
    </div>
  </ContactForm>

  <PageFooter slot="footer" href="/" class="py-8">
    <div class="container-bleed py-4">
      <div class="max-w-screen-2xl mx-auto">
        <span
          class="text-[12rem] leading-none text-zinc-900 text-shadow-zinc-600 dark:text-zinc-100 dark:text-shadow-zinc-400 sm:text-[13rem] md:text-[15rem] lg:text-[20rem]">
          BYE
        </span>
      </div>
    </div>
  </PageFooter>
</Layout>
