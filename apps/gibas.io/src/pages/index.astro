---
import Layout from '@layouts/Layout.astro'
import PageFooter from '@gibas/components/page/page-footer'
import ContactForm from '@gibas/components/contact-form'
import PageHeader from '@components/page-header.astro'
import Typewriter from '@components/typewriter.astro'
import PhotoGrid from '@components/photo-grid.astro'
import Link from '@gibas/components/link'
import ArrowRight from '@gibas/components/icons/arrow-right'
---

<Layout title="Maciej Gibas">
  <PageHeader class="h-screen" slot="header" location="Gainesville, Florida">
    <h1 class="text-6xl">
      <div>Hello <span class="inline-block origin-[70%_70%] animate-wave">👋🏼</span></div>
      <div>I'm Maciej Gibas</div>
      <Typewriter class="text-xl" prefix="Frontend" copy={['leader', 'architect', 'developer', 'designer']} />
    </h1>
    <h2 class="sr-only">Frontend leader, architect, developer and designer.</h2>
  </PageHeader>

  <h2>About</h2>

  <h3>Engineer, designer, and manager</h3>
  <p>
    I love creating software with people and for people! Helping others grow, solving engineering problems and reaching
    business goals is what drives me every day.
  </p>
  <p>
    Currently, I work as a frontend engineering lead at
    <Link href="https://infotechinc.com">Infotech</Link> with 5 brilliant developers. Together we take care of everything
    frontend, including new and existing products, development of our internal design system, and frontend strategy.
  </p>

  <h3>My approach</h3>
  <p>
    I'm very passionate about what I do and deliver, but at the same time, I'm first to criticize my work and pivot if
    necessary. I'm focused on my craft, peace, and quality. I empathize with users and try to solve their problems and
    achieve business goals. I firmly believe that software is 50% about engineering and 50% about people and
    collaboration.
  </p>
  <ul>
    <li><b>Software</b> - perfect is an enemy of good, fail fast, iterate.</li>
    <li><b>Design</b> - user-centric, function over form yet beautiful.</li>
    <li><b>Frontend</b> - light, accessible, close to the platform.</li>
    <li><b>Leadership</b> - deeply care, guide, and drive results collectively.</li>
    <li><b>Collaboration</b> - full ownership of your work, influence others and accept their influence.</li>
  </ul>

  <section class="container-bleed bg-theme-inverted mt-12 pb-12 overflow-auto">
    <div class="prose-inverted container">
      <h3>Personal life</h3>
      <p>
        After work, I spend most of my time with family and friends. I like brewing specialty ☕️ coffee, sport climbing
        🧗‍♂️, watching 🎬 movies, traveling (mostly for food 😉), hiking and couple other minor things 🏎 🏋🏼‍♀️ 🏓 🏃🏼
      </p>
    </div>
    <PhotoGrid class="not-prose mt-6" />
  </section>

  <section>
    <h3>Featured work</h3>
    <p>My personal projects or initiatives worth mentioning 🤘🏼</p>

    <ul class="mt-8 mb-0 p-0 list-none grid gap-8 sm:gap-16 sm:grid-cols-3">
      <li class="grid grid-rows-[auto_1fr_auto] mt-0 mb-0 p-0">
        <Link class="no-underline" bare href="https://ce.gibas.io/">Custom Elements Recipes</Link>
        <span class="text-secondary">
          A collection of custom elements recipes to help you get started with web components.
        </span>
        <Link class="mt-2 flex items-center gap-2" bare href="https://ce.gibas.io/">
          Check it out <ArrowRight class="h-5 w-5" />
        </Link>
      </li>
      <li class="grid grid-rows-[auto_1fr_auto] mt-0 mb-0 p-0">
        <Link class="no-underline" bare href="https://frontendies.io/">frontendies.io</Link>
        <span class="text-secondary">
          A monthly frontend newsletter delivering only essential things you don't want to miss.
        </span>
        <Link class="mt-2 flex items-center gap-2" bare href="https://frontendies.io/">
          Check it out <ArrowRight class="h-5 w-5" />
        </Link>
      </li>
      <li class="grid grid-rows-[auto_1fr_auto] mt-0 mb-0 p-0">
        <Link class="no-underline" bare href="https://www.npmjs.com/package/vue-router-fetch">vue-router-fetch</Link>
        <span class="text-secondary">
          Small vuejs plugin to move data fetching from your components to the router.
        </span>
        <Link class="mt-2 flex items-center gap-2" bare href="https://www.npmjs.com/package/vue-router-fetch">
          Check it out <ArrowRight class="h-5 w-5" />
        </Link>
      </li>
      <li class="grid grid-rows-[auto_1fr_auto] mt-0 mb-0 p-0">
        <Link class="no-underline" bare href="/talks/2022-10-20/">CSS Layouts</Link>
        <span class="text-secondary">
          Presentation from a talk I gave at Gainseville <Link
            class="font-normal"
            href="https://www.meetup.com/Gainesville-Front-End-Dev-Meetup/">
            Frontend Awesome
          </Link> meetup about CSS layouts.
        </span>
        <Link class="mt-2 flex items-center gap-2" bare href="/talks/2022-10-20/">
          Check it out <ArrowRight class="h-5 w-5" />
        </Link>
      </li>
    </ul>
  </section>

  <h2>Contact</h2>
  <ContactForm class="-mt-12" name="contact" title="Let's get in touch" title-tag="h3">
    <p class="mt-0 mb-0" slot="subtitle">
      If you have something interesting to share or simply want to say hi - use the form below or connect on
      <Link href="https://www.linkedin.com/in/gibasmaciej">LinkedIn</Link>.
    </p>
  </ContactForm>

  <PageFooter slot="footer" href="/" class="py-8">
    <div class="container-bleed py-4">
      <div class="max-w-screen-2xl mx-auto">
        <span
          class="text-[12rem] leading-none text-zinc-900 text-shadow-zinc-600 dark:text-zinc-100 dark:text-shadow-zinc-400 sm:text-[13rem] md:text-[15rem] lg:text-[20rem]">
          BYE
        </span>
      </div>
    </div>
  </PageFooter>
</Layout>
